# Variables opcionales del control (qhana-control --help). Copia a `.env` o expórtalas; `.env` NO se sube a git.
# Todas tienen valor por defecto: sin ninguna, el control corre en 127.0.0.1:47800 con token "dev".

# Dirección y puerto. Para agentes por Wi-Fi: 0.0.0.0:47800 (y usa un token propio, no "dev")
QHANA_ESCUCHAR=127.0.0.1:47800
# Token que el agente manda al conectarse. Vacío = sin token
QHANA_TOKEN=dev
QHANA_RECETAS=recetas
QHANA_DB=datos/control.db
QHANA_UI=ui/dist
# Ruta a adb / adb.exe (si no está en el PATH ni en el SDK de Android)
#QHANA_ADB=
# APK del agente, para el botón "Instalar agente"
#QHANA_APK=agente.apk
#QHANA_SIN_ADB=1
#QHANA_SIN_MODEMS=1
#QHANA_MODEM_PUERTOS=COM5,COM6
